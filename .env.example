# ============================================================
# Polaris — Environment Variable Reference
# Copy this file to .env and fill in the values before running.
# Lines starting with # are comments and are ignored at runtime.
# ============================================================

# ------------------------------------------------------------
# Application Name (optional — defaults to "Polaris")
# ------------------------------------------------------------
APP_NAME=Polaris

# ------------------------------------------------------------
# LLM Provider (REQUIRED)
# ------------------------------------------------------------

# Set to "cloudflare" to use Cloudflare Workers AI.
# For other providers use the langchain init_chat_model format: "<provider>:<model>"
# Examples:
#   cloudflare                              (use CLOUDFLARE_* vars below)
#   openai:gpt-4o
#   anthropic:claude-3-5-sonnet-20241022
#   ollama:llama3
LLM_PROVIDER=cloudflare

# ------------------------------------------------------------
# Cloudflare Workers AI (required when LLM_PROVIDER=cloudflare)
# ------------------------------------------------------------

# Cloudflare AI Gateway token
CLOUDFLARE_AIG_TOKEN=cfut_your_token_here

# Cloudflare account ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Cloudflare Workers AI model name
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ------------------------------------------------------------
# OpenAI (required when LLM_PROVIDER starts with "openai")
# ------------------------------------------------------------

# API key obtained from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ------------------------------------------------------------
# Azure OpenAI (optional — required when LLM_PROVIDER starts with "azure_openai")
# ------------------------------------------------------------

# Full Azure OpenAI endpoint URL, e.g. https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI API key (leave empty if not using Azure)
AZURE_OPENAI_API_KEY=

# ------------------------------------------------------------
# Anthropic (optional — required when LLM_PROVIDER starts with "anthropic")
# ------------------------------------------------------------

# API key obtained from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Ollama (optional — required when LLM_PROVIDER starts with "ollama")
# ------------------------------------------------------------

# Base URL of the locally running Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# Trino connection (REQUIRED — defaults are set for Docker Compose)
# ------------------------------------------------------------

# Hostname or IP address of the Trino coordinator
# Use "trino" when running inside Docker Compose, "localhost" for local dev
TRINO_HOST=trino

# Trino coordinator HTTP port (default: 8080)
TRINO_PORT=8080

# Default Trino catalog (optional — data sources are dynamically configured)
TRINO_CATALOG=system

# Default Trino schema (optional)
TRINO_SCHEMA=runtime

# Trino username to connect with
TRINO_USER=polaris

# ------------------------------------------------------------
# OpenMetadata connection (REQUIRED)
# ------------------------------------------------------------

# Base URL of the OpenMetadata server
# Use "http://openmetadata:8585" when running inside Docker Compose
OPENMETADATA_URL=http://openmetadata:8585

# OpenMetadata personal access token (Settings → Access Tokens)
# For local dev with no-auth mode, use any non-empty string
OPENMETADATA_API_TOKEN=your-openmetadata-api-token-here

# ------------------------------------------------------------
# Logging (optional — defaults shown)
# ------------------------------------------------------------

# Log verbosity level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Path to the log file written by the application
LOG_FILE=polaris.log
